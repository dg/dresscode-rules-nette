<?php
// {"Nette\\Utils\\Json::encode($value, $flags)": {"Nette\\Utils\\Json::PRETTY": {"pretty": true}, "Nette\\Utils\\Json::ESCAPE_UNICODE": {"asciiSafe": true}}, "Nette\\Utils\\Strings::match($subject, $pattern, $flags, ...)": {"PREG_OFFSET_CAPTURE": {"captureOffset": true}, "\\PREG_UNMATCHED_AS_NULL": {"unmatchedAsNull": true}, "PREG_SET_ORDER": {}}, "Nette\\Routing\\RouteList::add($router, $flags)": {"Nette\\Routing\\Router::ONE_WAY": {"oneWay": 1}}, "Nette\\Routing\\RouteList::prepend($router, $flags)": {"Nette\\Routing\\Router::ONE_WAY": {"oneWay": 1}}}

namespace App;

use Nette\Routing\Route;
use Nette\Routing\RouteList;
use Nette\Utils\Json;
use Nette\Utils\Strings;

class Routes extends RouteList
{
	public function run(Route $route): void
	{
		self::add($route, oneWay: 1);
		parent::prepend($route, oneWay: 1);
	}
}


function test(mixed $value, int $flags, RouteList $routes, Route $route): void
{
	$a = Json::encode($value, pretty: true);
	$b = Json::encode($value, pretty: true, asciiSafe: true);
	$c = $routes->add($route, oneWay: 1); // the interface that declares the constant
	$d = Strings::match('abc', '~b~', captureOffset: true, unmatchedAsNull: true);
	$e = \Nette\Utils\Json::encode($value, pretty: true);
	$l = Strings::match('abc', '~b~', captureOffset: true); // a flag the method now always applies
	$m = Strings::match('abc', '~b~', captureOffset: true, offset: 1); // the offset takes the name of its parameter

	// left alone: no flags, and the call the method takes now, a literal among them
	$f = Json::encode($value);
	$g = Json::encode($value, pretty: true);
	$h = Json::encode($value, true);
	$n = Json::encode($value, 0);

	// reported with the reason
	$i = Json::encode($value, $flags);
	$j = Json::encode($value, Json::PRETTY | Json::FORCE_ARRAY);
	$k = Strings::match('abc', '~b~', PREG_OFFSET_CAPTURE, 1, 2, 3, 4);
}
