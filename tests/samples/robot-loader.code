<?php

namespace App;

use Nette\Loaders\RobotLoader;


class Bootstrap
{
	public static function createLoader(string $appDir, string $tempDir): RobotLoader
	{
		$loader = new RobotLoader;
		$loader->addDirectory($appDir);
		$loader->excludeDirectory($appDir . '/templates');
		$loader->setTempDirectory($tempDir . '/cache');
		$loader->setAutoRefresh(on: false);
		$loader->reportParseErrors(on: true);
		$loader->setAutoRefresh(true);
		$loader->register();
		return $loader;
	}


	public function chained(string $appDir, string $tempDir): void
	{
		(new RobotLoader)
			->addDirectory($appDir)
			->setTempDirectory($tempDir)
			->register();

		$limit = RobotLoader::RETRY_LIMIT;
	}
}


class ModuleLoader extends RobotLoader
{
	public function __construct(string $tempDir)
	{
		parent::__construct();
		$this->setTempDirectory($tempDir);
		$this->reportParseErrors(on: false);
	}


	protected function getCacheKey(): array
	{
		return [...parent::getCacheKey(), 'modules', self::RETRY_LIMIT];
	}
}
