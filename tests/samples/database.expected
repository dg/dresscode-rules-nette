use Tracy;

class ArticleModel
{
	public function __construct(
		private Explorer $database,
		private Connection $connection,
	) {
	}


	public function fetchTitles(int $categoryId): array
	{
		$ids = $this->connection->fetchList('SELECT id FROM article WHERE category_id = ?', $categoryId);
		$names = $this->database->fetchList('SELECT name FROM category');
		$result = $this->database->query('SELECT * FROM article WHERE id IN (?)', $ids);
		$this->connection->queryArgs('DELETE FROM log WHERE id = ?', $params);
		$tags = $result->fetchList();
		$first = $result->fetch()['title'] ?? null;
		$count = $result->fetchField();
		$pairs = $result->fetchPairs(keyOrCallback: 'id', value: 'title');
		$connection = $result->getConnection();
		$tree = $this->database->table('article')->fetchAssoc('category_id[]=title');
		$title = $this->database->table('article')->fetchField('title');
		$tagSelection = $this->database->table('article')->createSelectionInstance('tag');
		return $this->database->table('article')->fetchPairs(keyOrCallback: 'id', value: 'title');
	}


	public function describe(IStructure $structure, Driver $driver, Driver $legacy): void
	{
		$belongsTo = $structure->getBelongsToReference('article', 'author_id');
		$allBelongsTo = $structure->getBelongsToReference('article');
		$hasMany = $structure->getHasManyReference('author', 'article');

		$subselect = $driver->isSupported(Driver::SUPPORT_SUBSELECT);
		$subselect = $driver->isSupported(Driver::SupportSubselect);
		$schema = $driver->isSupported(feature: Driver::SupportSchema);
		$orCond = $driver->isSupported(Driver::SupportMultiColumnAsOrCondition);
		$legacy->isSupported(Driver::SupportSequence);
		$bool = $driver->formatBool(true);
		$driver = $this->connection->getDriver();
	}


	public function convert(array $rows): array
	{
		return Helpers::toPairs($rows, null, null) + Helpers::toPairs($rows, 'id', null) + Helpers::toPairs($rows, 'id', 'name');
	}


	public function create(string $dsn, Conventions $conventions): Connection
	{
		$selection = new Selection(explorer: $this->database, conventions: $conventions, tableName: 'article');
		return new Connection($dsn, 'root', 'secret', ['driverClass' => Drivers\MyDriver::class] + (array) ['lazy' => true]);
	}


	public function legacy(): string
	{
		return \Nette\Database\Drivers\Sqlite2Driver::class;
	}


	public function render(IRow $row, IRowContainer $rows, \Nette\Database\Table\ActiveRow $activeRow, \Nette\Database\Table\Selection $selection): void
	{
		if ($row instanceof \Nette\Database\Table\ActiveRow) {
		}
	}
}


class FakeRow implements \Nette\Database\Table\IRow
{
}


class Bootstrap
{
	public function setupTracy(Connection $connection, Tracy\Bar $bar, Tracy\BlueScreen $blueScreen, ConnectionPanel $panel): void
	{
		ConnectionPanel::initialize($connection, true);
		ConnectionPanel::initialize($connection, true, '', false);
		ConnectionPanel::initialize($connection, true, 'main', true);
		$second = ConnectionPanel::initialize($connection, true, 'main', true, $bar, $blueScreen);
		ConnectionPanel::initialize($connection, true, 'second');
		$panel->logQuery($connection, null);
	}
}


class ArticleSelection extends Selection
{
	public function reset(): void
	{
		$this->emptyResultSet(deleteReferencedCache: false);
		$explorer = $this->explorer;
		$self = self::createSelectionInstance();
	}


	protected function createRow(array $row): ActiveRow
	{
		return new ActiveRow($row, $this);
	}


	protected function createGroupedSelectionInstance(string $table, string $column): GroupedSelection
	{
		return parent::createGroupedSelectionInstance($table, $column);
	}
}


class CommentSelection extends GroupedSelection
{
	public function reset(): void
	{
		$this->emptyResultSet(clearCache: false);
		$this->emptyResultSet(deleteReferencedCache: false, clearCache: false);
		$this->emptyResultSet(deleteReferencedCache: false);
	}
}
