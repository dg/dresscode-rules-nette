class LatteFactory
{
	public function create(string $tempDir, \Tracy\Bar $bar): Latte\Engine
	{
		$latte = new Latte\Engine;
		$latte->setTempDirectory($tempDir);
		$latte->setAutoRefresh(on: true);
		$latte->setSandboxMode(on: false);
		$latte->setStrictTypes();
		$latte->setStrictParsing(true);
		$latte->setMigrationWarnings(false);
		$latte->setExceptionHandler(callback: fn(\Throwable $e) => null);
		$latte->addProvider('formatter', value: new \stdClass);
		$latte->addFilterLoader([$this, 'loadFilter']);
		$latte->setContentType(Latte\Engine::CONTENT_XML);
		if (!$latte->isStrictParsing()) {
			$latte->setStrictParsing(on: true);
		}

		LattePanel::initialize($latte);
		LattePanel::initialize($latte, 'mail');
		LattePanel::initialize($latte, 'admin', $bar);
		$bar->addPanel(new LattePanel($latte));

		Filters::$dateFormat = 'j. n. Y';
		$version = Latte\Engine::VERSION;
		$template = $latte->parse(source: '{$foo}');
		return $latte;
	}


	public function lint(Linter $linter): bool
	{
		return $linter->scanDirectory(dir: __DIR__);
	}


	public function loadFilter(string $name): ?callable
	{
		return null;
	}
}


class TemplateHelpers
{
	/** @filter */
	public function money(float $value): string
	{
		return number_format($value, 2);
	}


	/**
	 * Tells whether the user may see the item.
	 * @function
	 */
	public function isVisible(string $item): bool
	{
		return true;
	}
}


class DatabaseLoader implements Latte\Loader
{
	public function getContent(string $name): string
	{
		return '';
	}


	public function isExpired(string $name, int $time): bool
	{
		return false;
	}


	public function getReferredName(string $name, string $referringName): string
	{
		return $name;
	}


	public function getUniqueId(string $name): string
	{
		return $name;
	}
}


class CachingEngine extends Latte\Engine
{
	protected function getCacheKey(): array
	{
		return parent::getCacheKey();
	}
}


class IconNode extends StatementNode
{
	use Latte\Strict;

	public ?ModifierNode $modifier = null;


	public static function create(Tag $tag): static
	{
		$node = new static;
		$foreach = $tag->closestTag(names: [ForeachNode::class]);
		$data = $tag->data;
		$location = $tag->location;
		$attribute = $tag->nAttributeNode;
		$node->modifier = new ModifierNode([], true, false, $tag->position);
		if ($tag->parser->tryConsumeModifier('as')) {
			$words = $tag->position->toWords();
		}

		return $node;
	}


	public function print(PrintContext $context): string
	{
		return '';
	}


	public function describe(PrintContext $context, FilterNode $filter, NameNode $name, ElementNode $element, ForeachNode $foreach, JumpNode $jump): string
	{
		$code = $filter->printSimple($context, '$value');
		$chain = FilterNode::printSimple($context, [$filter], '$value');
		$parts = $name->parts;
		$escape = FilterNode::Escape;
		$tagName = $element->variableName ?? $element->customName;
		$captured = $element->captureTagName;
		$tag = $element->tagNode;
		$else = $foreach->elseLine;
		$end = $jump->endTag;
		$names = Token::NAMES;
		$source = Template::Source;
		return $code . $escape;
	}


	public function inspect(PrintContext $context, FunctionCallNode $call, MethodCallNode $method, mixed $node): string
	{
		if ($call->isFirstClassCallable() || $method->isFirstClassCallable()) {
			return '';
		} elseif ($node instanceof NotNode || $node instanceof ErrorSuppressNode) {
			return $context->prefixOp($node, '!', $node->expr);
		} elseif ($node instanceof FunctionCallableNode || $node instanceof NullsafeMethodCallNode) {
			return $context->infixOp($node, $node->object, '?->', $node->name);
		} elseif ($node instanceof StaticCallNode || $node instanceof QuotedValue || $node instanceof EncapsedStringPartNode) {
			return $context->postfixOp($node, $node, '++');
		} elseif ($node instanceof StaticCallableNode || $node instanceof VariadicPlaceholderNode) {
			return '';
		}

		$array = ArrayNode::fromArguments($call->args);
		$string = StringNode::parse('"a"', position: null);
		$builder = new ExpressionBuilder;
		return '';
	}


	public function parse(TemplateParser $parser, TemplateLexer $lexer, Latte\Compiler\Nodes\TemplateNode $templateNode): void
	{
		try {
			$parser->parse('{$a}', $lexer);
		} catch (Latte\RegexpException $e) {
		}

		Passes::moveTemplatePrintToHeadPass($templateNode);
	}
}
