<?php

namespace App;

use Nette\Application\Application;
use Nette\Application\Attributes\Persistent;
use Nette\Application\Attributes\Requires;
use Nette\Application\Response;
use Nette\Application\IRouter;
use Nette\Application\LinkGenerator;
use Nette\Application\Request;
use Nette\Application\Routers\CliRouter;
use Nette\Application\Routers\Route;
use Nette\Application\Routers\RouteList;
use Nette\Application\Routers\SimpleRouter;
use Nette\Application\UI\Control;
use Nette\Application\UI\Form;
use Nette\Application\UI\Renderable;
use Nette\Application\UI\TemplateFactory;
use Nette\Application\UI\Presenter;
use Nette\Application\UI\Component;
use Nette\Bridges\ApplicationLatte\Loader;
use Nette\Bridges\ApplicationLatte\Template;
use Nette\Bridges\ApplicationLatte\UIMacros;
use Nette\Routing\Router;


class RouterFactory
{
	public static function createRouter(): Router
	{
		Route::$defaultFlags = Route::SECURED;
		Route::$styles['id'] = [Route::Pattern => '\d+'];

		$router = new RouteList;
		$router->add(new Route('admin/<presenter>/<action>', [Route::MODULE_KEY => 'Admin', Route::PRESENTER_KEY => 'Dashboard']));
		$router->add(new Route('old/<id>', 'Old:default', Route::ONE_WAY));
		$router->add(new SimpleRouter([SimpleRouter::PRESENTER_KEY => 'Homepage'], IRouter::SECURED));
		$router[1] = new CliRouter([CliRouter::PRESENTER_KEY => 'Cli']);
		unset($router[1]);

		if (isset($router->getRouters()[0]) && \count($router->getRouters()) > 0) {
			$first = $router->getRouters()[0];
		}

		foreach ($router->getIterator() as $route) {
		}

		return $router;
	}


	public static function describe(Route $route, SimpleRouter $simple): array
	{
		return [$route->getFlags(), $simple->getFlags(), $route->getTargetPresenters()];
	}
}


class BaseComponent extends Control
{
	public static function getPersistentParams(): array
	{
		return ['page'];
	}


	public function attachTo(Component $parent): void
	{
	}
}


/**
 * @persistent(menu)
 */
abstract class BasePresenter extends Presenter
{
	#[Persistent]
	public $lang;

	/** @persistent  Default language */
	public $locale;


	protected function startup(): void
	{
		parent::startup();
		$container = $this->getContext();
		$id = $this->getParameter('id');
		$all = $this->getParameters();
		$page = $this->getParameter('page') ?? 1;
		$sort = $this->getParameter('sort') ?? 'name';

		if ($this->getAction() === 'edit' && $this->getView() !== 'default') {
			$this->setLayout('wide');
			$this->setView('edit');
		}

		$layout = $this->getLayout();
		$method = $this->getRequest()->getMethod();
		$section = $this->getSession()->getSection('app');
		$backlink = $this->getAction(true);

		if (!$this->getRequest()->isMethod('POST') && $this->getRequest()->getParameters()) {
			$this->getRequest()->setParameters(['id' => $id]);
			$this->redirectPermanent('Homepage:');
		}
	}


	#[Requires(sameOrigin: false)]
	public function handleVote(): void
	{
		$this->redrawControl('votes');
		$this->redrawControl(null, false);
		$this->redrawControl('header', false);
		$this->redirectPermanent('this', ['voted' => true]);
		$this->redirect('this');
	}


	#[Requires(sameOrigin: false)]
	public function handleShare(): void
	{
		$this->redirect('Product:show', ['id' => '1', '#' => 'share']);
	}


	protected function createRequest($component, $destination, array $args, $mode): ?string
	{
		return parent::createRequest($component, $destination, $args, $mode);
	}


	public function beforeRender(): void
	{
		$url = $this->requestToUrl($this->getRequest());
		$parts = LinkGenerator::parseDestination('Homepage:default');
		$parsed = LinkGenerator::parseDestination('Product:show');
		$state = [];
		$this->saveState($state, $this->getReflection());
	}
}


class MenuControl extends Control implements Renderable
{
	public function render(): void
	{
		$presenter = $this->getPresenter();
		$current = $this->isLinkCurrent();
		$attached = $this->getPresenter(throw: false) !== null;
		$maybe = $this->getPresenter(throw: false);
		$id = $this->getSnippetId('');
		$this->template->render(__DIR__ . '/menu.latte');
	}
}


class SignFormFactory
{
	public function create(Form $form): Form
	{
		$form->allowCrossOrigin();
		if ($form->getPresenter(throw: false) !== null && $form->getPresenter(throw: false)) {
			$form->getPresenter()->flashMessage('ok');
		}

		return $form;
	}
}


class Mailer
{
	public function __construct(
		private LinkGenerator $linkGenerator,
		private Application $application,
		private TemplateFactory $templateFactory,
	) {
	}


	public function send(Request $request, Presenter $presenter, Response $response, \Throwable $e): string
	{
		$request->setPresenterName('Front:Homepage');
		$request->setPost([]);
		$name = $request->getPresenterName();
		$files = $request->getFiles();
		$post = $request->getPost();
		$secured = $request->hasFlag(Request::SECURED);
		$invalid = $presenter->invalidLinkMode === Presenter::InvalidLinkException;

		$presenter->injectPrimary($presenter->getHttpRequest(), $presenter->getHttpResponse(), null, null, null, null, null);
		$this->application->processException($e);
		return $this->linkGenerator->link(destination: 'Homepage:', args: ['id' => 1])
			. $this->linkGenerator->link('Product:show', args: ['id' => 2]);
	}


	public function prepare(Template $template): void
	{
		$template->getLatte()->addFilter('money', fn($value) => "$value CZK");
		$template->blueprint();
	}


	public function createLoader(Presenter $presenter): Loader
	{
		return new Loader($presenter);
	}


	public function install(UIMacros $macros): void
	{
	}
}
