<?php

namespace App;

use Nette\DI\Compiler;
use Nette\DI\CompilerExtension;
use Nette\DI\Config\Adapters\IniAdapter;
use Nette\DI\Extensions\DefinitionSchema;
use Nette\DI\Config\Helpers;
use Nette\DI\Config\Adapter;
use Nette\DI\Config\Loader;
use Nette\DI\Container;
use Nette\DI\ContainerBuilder;
use Nette\DI\Definitions\AccessorDefinition;
use Nette\DI\Definitions\Definition;
use Nette\DI\Definitions\FactoryDefinition;
use Nette\DI\Definitions\LocatorDefinition;
use Nette\DI\Definitions\Reference;
use Nette\DI\DependencyChecker;
use Nette\Bootstrap\Extensions\ConstantsExtension;
use Nette\DI\Extensions\InjectExtension;
use Nette\DI\PhpGenerator;
use Nette\DI\Definitions\ServiceDefinition;
use Nette\DI\Definitions\Statement;


class MailerExtension extends CompilerExtension
{
	public function loadConfiguration(): void
	{
		$config = $this->getConfig(['host' => 'localhost']);
		$builder = $this->getContainerBuilder();

		$mailer = $builder->addDefinition($this->prefix('mailer'));
		assert($mailer instanceof ServiceDefinition);
		$mailer->setType(Mailer::class);
		$mailer->setCreator(Mailer::class, [$config['host']]);
		$mailer->setCreator(Mailer::class, [$config['host']]);
		$mailer->setCreator(creator: Mailer::class);
		$mailer->addTag(InjectExtension::TagInject);
		$mailer->addTag(InjectExtension::TagInject, false);
		$mailer->addTag(InjectExtension::TagInject);
		$mailer->addTag(InjectExtension::TagInject);
		$mailer->addSetup('setLogger', [new Statement('@logger')]);
		$mailer->setDynamic();
		$mailer->setImplement(IMailerFactory::class);
		$mailer->setImplementMode('create');
		$mailer->setParameters(['host']);
		$mailer->parameters = [];
		$params = $mailer->getParameters();

		if ($mailer->getTag(InjectExtension::TagInject) && $mailer->getImplement() === null && !$mailer->isDynamic()) {
			$type = $mailer->getType();
			$factory = $mailer->getCreator();
		}

		$builder->addDefinition($this->prefix('self'))
			->setCreator(ContainerBuilder::ThisContainer);
		$builder->resolve();
		$builder->setClassName('MyContainer');
		$className = $builder->getClassName();
		$mode = $mailer->getImplementMode();
		$builder->expand('%tempDir%');
		$builder->completeStatement(new Statement(Mailer::class));
		$reference = Reference::Self;
		$version = DependencyChecker::Version;
	}


	public function beforeCompile(): void
	{
		$builder = $this->getContainerBuilder();
		$factory = $builder->addFactoryDefinition($this->prefix('factory'));
		$factory->setImplement(interface: IMailerFactory::class);
		$factory->addSetup('setLogger');
		$factory->setArguments(['localhost']);
		$entity = $factory->getResultDefinition()->getEntity();
		$setup = $factory->getResultDefinition()->getSetup();
		$created = $factory->getResultDefinition()->getCreator();
		$factory->setParameters(['host']);
		$factory->parameters = [];

		$accessor = $builder->addAccessorDefinition($this->prefix('accessor'));
		$accessor->setImplement(interface: IMailerAccessor::class);
		$locator = $builder->addLocatorDefinition($this->prefix('locator'));
		$locator->setImplement(interface: IMailerLocator::class);

		foreach ($builder->getDefinitions() as $def) {
			if ($def->isDynamic()) {
				$def->addTag(InjectExtension::TagInject);
			}
		}

		$arguments = \Nette\DI\Helpers::filterArguments(['@mailer']);
		$code = $builder->formatStatement(new Statement(Mailer::class));
		$classes = $builder->generateClasses();
		(new PhpGenerator($builder))->convertParameters([]);
	}
}


class OverwritingExtension extends MailerExtension
{
	public function getConfig()
	{
		$config = parent::getConfig(['debug' => false]);
		$config[Helpers::PREVENT_MERGING] = Helpers::OVERWRITE;
		if (Helpers::isOverwriting($config) || Helpers::isInheriting($config)) {
			return Helpers::merge($config, []);
		}

		return $config;
	}
}


class Bootstrap
{
	public static function compile(Compiler $compiler, Loader $loader, Adapter $adapter): string
	{
		$compiler->addExtension('constants', new ConstantsExtension);
		$compiler->addExtension('ini', new IniAdapter);
		$compiler->loadDefinitions();
		Compiler::parseServices($compiler->getContainerBuilder(), []);
		$loader->save(['services' => []], __DIR__ . '/config.neon');
		$schema = new DefinitionSchema;
		$compiler->addConfig(['parameters' => []])->setClassName('MyContainer')->compile();
		$compiler->setClassName('MyContainer')->compile();
		return $compiler->addConfig(['parameters' => []])->compile();
	}


	public static function run(Container $container): void
	{
		$mailer = $container->getService('mailer');
		$container->addService('logger', new Logger);
		if ($container->hasService('cache')) {
			$container->removeService('cache');
		}

		$appDir = $container->getParameters()['appDir'];
		$tempDir = $container->expand('%tempDir%');
		$container->createService('mailer', ['localhost']);
		$container->createService('mailer');
	}
}


class MyContainer extends Container
{
	public function describe(): array
	{
		$keys = [self::TYPES, self::SERVICES, self::ALIASES, self::TAGS];
		$wiring = $this->meta[self::TYPES] + $this->types;
		return $keys + $wiring + ['debug' => $this->getParameters()['debugMode']];
	}
}


class StatementFactory
{
	public function create(Statement $statement, Definition $definition): Statement
	{
		$statement->setEntity(Mailer::class);
		$type = $definition->getType();
		return $statement;
	}
}


class Mailer
{
}


class Logger
{
}


interface IMailerFactory
{
	function create(): Mailer;
}


interface IMailerAccessor
{
	function get(): Mailer;
}


interface IMailerLocator
{
	function getMailer(): Mailer;
}
