{
	"name": "dresscode/rules-nette",
	"description": "👔 DressCode rules for Nette: upgrades code written for older versions of the Nette libraries to the API of the versions a project stands on, and reports what has to be rewritten by hand.",
	"keywords": ["nette", "upgrade", "migration", "deprecations", "refactoring", "modernization", "dresscode", "latte", "tracy"],
	"homepage": "https://dresscode.run",
	"type": "dresscode-extension",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "dev-master"
	},
	"require-dev": {
		"latte/latte": "^3.1",
		"nette/application": "^3.2",
		"nette/assets": "^1.0",
		"nette/bootstrap": "^3.3",
		"nette/caching": "^3.4",
		"nette/database": "^3.2",
		"nette/di": "^3.2",
		"nette/forms": "^3.2",
		"nette/http": "^3.3",
		"nette/mail": "^4.2",
		"nette/neon": "^3.4",
		"nette/php-generator": "^4.2",
		"nette/phpstan-rules": "^1.0",
		"nette/robot-loader": "^4.1",
		"nette/routing": "^3.1",
		"nette/schema": "^1.3",
		"nette/security": "^3.2",
		"nette/tester": "^2.6",
		"nette/utils": "^4.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"tracy/tracy": "^2.12"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"DressCode\\Nette\\": "src"
		}
	},
	"scripts": {
		"tester": "tester tests -s",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"extension": "DressCode\\Nette\\Extension",
			"upgrading": [
				"upgrading/assets.neon",
				"upgrading/bootstrap.neon",
				"upgrading/caching.neon",
				"upgrading/database.neon",
				"upgrading/di.neon",
				"upgrading/forms.neon",
				"upgrading/http.neon",
				"upgrading/latte.neon",
				"upgrading/mail.neon",
				"upgrading/neon.neon",
				"upgrading/php-generator.neon",
				"upgrading/robot-loader.neon",
				"upgrading/routing.neon",
				"upgrading/schema.neon",
				"upgrading/security.neon",
				"upgrading/tracy.neon",
				"upgrading/utils.neon"
			]
		}
	}
}
