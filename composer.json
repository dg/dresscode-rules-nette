{
	"name": "dresscode/upgrade-nette",
	"description": "👔 DressCode Upgrade for Nette: rewrites code written for older Nette, Latte and Tracy to the current API, annotations included, and reports the rest with what to write instead.",
	"keywords": ["nette", "latte", "tracy", "upgrade", "upgrading", "migration", "deprecations", "refactoring", "codemod", "attributes", "dresscode", "rector"],
	"homepage": "https://dresscode.run/upgrading-nette",
	"type": "dresscode-plugin",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "^1.2"
	},
	"require-dev": {
		"latte/latte": "^3.1",
		"nette/application": "^3.2",
		"nette/assets": "^1.0",
		"nette/bootstrap": "^3.3",
		"nette/caching": "^3.4",
		"nette/database": "^3.2",
		"nette/di": "^3.2",
		"nette/forms": "^3.2",
		"nette/http": "^3.3",
		"nette/mail": "^4.2",
		"nette/neon": "^3.4",
		"nette/php-generator": "^4.2",
		"nette/phpstan-rules": "^1.0",
		"nette/robot-loader": "^4.1",
		"nette/routing": "^3.1",
		"nette/schema": "^1.3",
		"nette/tester": "^2.6",
		"nette/utils": "^4.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"tracy/tracy": "^2.12"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"DressCodeUpgrade\\Nette\\": "src"
		}
	},
	"scripts": {
		"tester": "tester tests -s",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"plugin": "DressCodeUpgrade\\Nette\\Plugin",
			"upgrading-dir": "upgrading",
			"packages": [
				"latte/latte",
				"nette/assets",
				"nette/bootstrap",
				"nette/caching",
				"nette/database",
				"nette/di",
				"nette/forms",
				"nette/http",
				"nette/mail",
				"nette/neon",
				"nette/php-generator",
				"nette/robot-loader",
				"nette/routing",
				"nette/schema",
				"nette/utils",
				"tracy/tracy"
			]
		}
	}
}
