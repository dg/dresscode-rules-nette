{
	"name": "dresscode/rules-nette",
	"description": "👔 Upgrades code written for older Nette to the current API: renamed classes, constants, methods and annotations are rewritten, the rest is reported with what to write instead.",
	"keywords": ["nette", "nette 3", "latte", "tracy", "upgrade", "upgrading", "migration", "deprecations", "refactoring", "codemod", "attributes", "dresscode"],
	"homepage": "https://dresscode.run/upgrading-nette",
	"type": "dresscode-plugin",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "dev-master"
	},
	"require-dev": {
		"nette/application": "^3.2",
		"nette/assets": "^1.0",
		"nette/bootstrap": "^3.3",
		"nette/caching": "^3.4",
		"nette/forms": "^3.2",
		"nette/http": "^3.3",
		"nette/mail": "^4.2",
		"nette/phpstan-rules": "^1.0",
		"nette/robot-loader": "^4.1",
		"nette/schema": "^1.3",
		"nette/tester": "^2.6",
		"nette/utils": "^4.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"tester": "tester tests -s",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"upgrading": [
				"upgrading/assets.neon",
				"upgrading/bootstrap.neon",
				"upgrading/caching.neon",
				"upgrading/forms.neon",
				"upgrading/http.neon",
				"upgrading/mail.neon",
				"upgrading/robot-loader.neon",
				"upgrading/schema.neon"
			]
		}
	}
}
