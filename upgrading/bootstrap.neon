package: nette/bootstrap
group: deprecations

since 3.2.1:
	replaced-calls:
		'Nette\Bootstrap\Configurator::onCompile(...$args)': '\Nette\Utils\Arrays::invoke($this->onCompile, ...$args)'

since 3.1.4:
	replaced-members:
		Nette\Bootstrap\Configurator::COOKIE_SECRET: CookieSecret

since 3.1:
	replaced-classes:
		Nette\Configurator: Nette\Bootstrap\Configurator
	replaced-members:
		Nette\Bootstrap\Configurator::addParameters: addStaticParameters
		Nette\Configurator::$parameters: $staticParameters

since 3.0:
	replaced-classes:
		Nette\Bridges\Framework\TracyBridge: Tracy\Bridges\Nette\Bridge
	replaced-members:
		Nette\Configurator::$files: $configs
		Nette\Configurator::enableDebugger: enableTracy
	forbidden-members:
		Nette\Configurator::AUTO: 'there is no replacement, sections of a configuration file are gone; split the configuration into files and add the one for the mode, such as by isDebugMode()'
		Nette\Configurator::NONE: 'there is no replacement, sections of a configuration file are gone; add the configuration file without a section'
		'Nette\Configurator::addConfig($config, $section)': 'the second argument selecting a section is ignored, sections being gone; split the configuration into files and add the one needed'
		Nette\Configurator::fixCompatibility: 'there is no replacement, the class no longer calls it and the nette.* sections are not translated; rename them, such as nette.application to application'
