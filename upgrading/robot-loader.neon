package: nette/robot-loader
group: deprecations

since 4.1.3:
	replaced-members:
		Nette\Loaders\RobotLoader::setTempDirectory: setCacheDirectory

since 4.0.2:
	replaced-calls:
		'Nette\Loaders\RobotLoader::reportParseErrors(on: $state)': 'reportParseErrors(state: $state)'
		'Nette\Loaders\RobotLoader::setAutoRefresh(on: $state)': 'setAutoRefresh(state: $state)'

since 4.0:
	replaced-members:
		Nette\Loaders\RobotLoader::getCacheKey: generateCacheKey

since 3.2:
	forbidden-members:
		Nette\Loaders\RobotLoader::RETRY_LIMIT: 'there is no replacement, the constant is private; write the limit as a value'
