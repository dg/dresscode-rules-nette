package: nette/neon

since 3.4:
	replacedCalls:
		'Nette\Neon\Entity::__construct($value, attrs: $attributes)': 'new \Nette\Neon\Entity($value, attributes: $attributes)'
	nette.flagsAsNamedArguments:
		'Nette\Neon\Neon::encode($value, $blockMode, ...)':
			Nette\Neon\Neon::BLOCK: {blockMode: true}

since 3.3.3:
	replacedMembers:
		Nette\Neon\Neon::CHAIN: Chain

since 3.3.1:
	replacedCalls:
		'Nette\Neon\Neon::encode($value, flags: $flags)': 'encode($value, blockMode: $flags)'

since 3.2.2:
	replacedCalls:
		'Nette\Neon\Neon::encode(var: $value, ...)': 'encode(value: $value, ...)'
