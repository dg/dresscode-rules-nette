package: nette/schema

since 1.4:
	forbiddenMembers:
		Nette\Schema\Elements\Type::items: keep
		Nette\Schema\Elements\StringType::items: 'a string has no items; drop the call'
		Nette\Schema\Elements\StringType::mergeDefaults: 'a string has no default merging; drop the call'
		Nette\Schema\Elements\NumberType::pattern: 'a number has no pattern; drop the call'
		Nette\Schema\Elements\NumberType::items: 'a number has no items; drop the call'
		Nette\Schema\Elements\NumberType::mergeDefaults: 'a number has no default merging; drop the call'
		Nette\Schema\Elements\ArrayType::pattern: 'an array has no pattern; drop the call'

since 1.3.2:
	replacedCalls:
		'Nette\Schema\Expect::structure(items: $shape)': 'structure(shape: $shape)'
		'Nette\Schema\Elements\Structure::__construct(items: $shape)': 'new \Nette\Schema\Elements\Structure(shape: $shape)'

since 1.2.4:
	replacedMembers:
		Nette\Schema\Message::TYPE_MISMATCH: TypeMismatch
		Nette\Schema\Message::VALUE_OUT_OF_RANGE: ValueOutOfRange
		Nette\Schema\Message::LENGTH_OUT_OF_RANGE: LengthOutOfRange
		Nette\Schema\Message::PATTERN_MISMATCH: PatternMismatch
		Nette\Schema\Message::FAILED_ASSERTION: FailedAssertion
		Nette\Schema\Message::MISSING_ITEM: MissingItem
		Nette\Schema\Message::UNEXPECTED_ITEM: UnexpectedItem
		Nette\Schema\Message::DEPRECATED: Deprecated
		Nette\Schema\Helpers::PREVENT_MERGING: PreventMerging

since 1.2:
	replacedCalls:
		'Nette\Schema\Expect::arrayOf(type: $type, ...)': 'arrayOf(valueType: $type, ...)'

since 1.0.3:
	forbiddenMembers:
		Nette\Schema\Elements\Type::items: 'use `Nette\Schema\Expect::arrayOf()` for an array schema or `Nette\Schema\Expect::listOf()` for a list schema'
