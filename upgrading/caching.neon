package: nette/caching
intent: deprecations

since 3.4:
	forbiddenClasses:
		Nette\Bridges\CacheLatte\CacheMacro: 'support for Latte 2 is gone; use Latte 3 and register `Nette\Bridges\CacheLatte\CacheExtension`'

since 3.2.2:
	forbiddenMembers:
		Nette\Caching\Storages\FileStorage::$useDirectories: 'there is no replacement; the storage always creates subdirectories'

since 3.1.3:
	replacedMembers:
		Nette\Caching\Cache::PRIORITY: Priority
		Nette\Caching\Cache::EXPIRATION: Expire
		Nette\Caching\Cache::EXPIRE: Expire
		Nette\Caching\Cache::SLIDING: Sliding
		Nette\Caching\Cache::TAGS: Tags
		Nette\Caching\Cache::FILES: Files
		Nette\Caching\Cache::ITEMS: Items
		Nette\Caching\Cache::CONSTS: Constants
		Nette\Caching\Cache::CALLBACKS: Callbacks
		Nette\Caching\Cache::NAMESPACES: Namespaces
		Nette\Caching\Cache::ALL: All

since 3.1:
	replacedClasses:
		Nette\Caching\IStorage: Nette\Caching\Storage
		Nette\Caching\Storages\IJournal: Nette\Caching\Storages\Journal
		Nette\Caching\IBulkReader: Nette\Caching\BulkReader
	replacedMembers:
		Nette\Caching\Cache::start: capture
	replacedCalls:
		'Nette\Caching\Cache::load(fallback: $f, ...)': 'load(generator: $f, ...)'
		'Nette\Caching\Cache::bulkLoad(fallback: $f, ...)': 'bulkLoad(generator: $f, ...)'

since 3.0:
	replacedClasses:
		Nette\Caching\Storages\NewMemcachedStorage: Nette\Caching\Storages\MemcachedStorage
	replacedCalls:
		'Nette\Caching\Storages\MemcachedStorage::addServer($host, $port, $timeout)': 'addServer($host, $port)'
