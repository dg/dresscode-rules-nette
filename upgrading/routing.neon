package: nette/routing
intent: deprecations

since 3.1.4:
	nette.flagsAsNamedArguments:
		'Nette\Routing\RouteList::add($router, $flags)':
			Nette\Routing\Router::ONE_WAY: {oneWay: 1}
		'Nette\Routing\RouteList::prepend($router, $flags)':
			Nette\Routing\Router::ONE_WAY: {oneWay: 1}
		'Nette\Routing\RouteList::addRoute($mask, $metadata, $flags)':
			Nette\Routing\Router::ONE_WAY: {oneWay: 1}

since 3.1:
	replacedCalls:
		'Nette\Routing\RouteList::add(flags: $f, ...)': 'add(oneWay: $f, ...)'
		'Nette\Routing\RouteList::prepend(flags: $f, ...)': 'prepend(oneWay: $f, ...)'
		'Nette\Routing\RouteList::addRoute(flags: $f, ...)': 'addRoute(oneWay: $f, ...)'

since 3.0.3:
	replacedMembers:
		Nette\Routing\Route::VALUE: Value
		Nette\Routing\Route::PATTERN: Pattern
		Nette\Routing\Route::FILTER_IN: FilterIn
		Nette\Routing\Route::FILTER_OUT: FilterOut
		Nette\Routing\Route::FILTER_TABLE: FilterTable
		Nette\Routing\Route::FILTER_STRICT: FilterStrict
