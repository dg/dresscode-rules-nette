package: nette/http
group: deprecations

since 3.4:
	replaced-calls:
		'Nette\Http\Request::isSameSite()': 'isFrom([\Nette\Http\FetchSite::SameSite, \Nette\Http\FetchSite::SameOrigin])'
		'Nette\Http\Helpers::ipMatch($ip, $mask)': '\Nette\Http\IPAddress::tryFrom($ip)?->isInRange($mask) ?? false'
	forbidden-members:
		Nette\Http\IRequest::getRemoteHost: 'there is no replacement, the method always returns null'

since 3.3.2:
	forbidden-members:
		Nette\Http\UrlImmutable::build: 'there is no replacement, the protected method is gone'
		Nette\Http\UrlScript::build: 'there is no replacement, the protected method is gone'

since 3.2.4:
	replaced-members:
		Nette\Http\FileUpload::getImageFileExtension: getSuggestedExtension

since 3.2.3:
	replaced-members:
		Nette\Http\FileUpload::IMAGE_MIME_TYPES: keep
	forbidden-members:
		Nette\Http\FileUpload::IMAGE_MIME_TYPES: 'there is no replacement, isImage() decides by the image types the PHP build supports'
		Nette\Http\FileUpload::ImageMimeTypes: 'there is no replacement, isImage() decides by the image types the PHP build supports'

since 3.2.2:
	forbidden-members:
		Nette\Http\Session::getIterator: 'call getSectionNames(), which returns an array of the names of the sections instead of an iterator'

since 3.2.1:
	replaced-members:
		Nette\Http\FileUpload::IMAGE_MIME_TYPES: ImageMimeTypes
		Nette\Http\Helpers::STRICT_COOKIE_NAME: StrictCookieName
		Nette\Http\IRequest::DELETE: Delete
		Nette\Http\IRequest::GET: Get
		Nette\Http\IRequest::HEAD: Head
		Nette\Http\IRequest::OPTIONS: Options
		Nette\Http\IRequest::PATCH: Patch
		Nette\Http\IRequest::POST: Post
		Nette\Http\IRequest::PUT: Put
		Nette\Http\IResponse::REASON_PHRASES: ReasonPhrases
		Nette\Http\IResponse::S100_CONTINUE: S100_Continue
		Nette\Http\IResponse::S101_SWITCHING_PROTOCOLS: S101_SwitchingProtocols
		Nette\Http\IResponse::S102_PROCESSING: S102_Processing
		Nette\Http\IResponse::S201_CREATED: S201_Created
		Nette\Http\IResponse::S202_ACCEPTED: S202_Accepted
		Nette\Http\IResponse::S203_NON_AUTHORITATIVE_INFORMATION: S203_NonAuthoritativeInformation
		Nette\Http\IResponse::S204_NO_CONTENT: S204_NoContent
		Nette\Http\IResponse::S205_RESET_CONTENT: S205_ResetContent
		Nette\Http\IResponse::S206_PARTIAL_CONTENT: S206_PartialContent
		Nette\Http\IResponse::S207_MULTI_STATUS: S207_MultiStatus
		Nette\Http\IResponse::S208_ALREADY_REPORTED: S208_AlreadyReported
		Nette\Http\IResponse::S226_IM_USED: S226_ImUsed
		Nette\Http\IResponse::S300_MULTIPLE_CHOICES: S300_MultipleChoices
		Nette\Http\IResponse::S301_MOVED_PERMANENTLY: S301_MovedPermanently
		Nette\Http\IResponse::S302_FOUND: S302_Found
		Nette\Http\IResponse::S303_POST_GET: S303_PostGet
		Nette\Http\IResponse::S303_SEE_OTHER: S303_PostGet
		Nette\Http\IResponse::S304_NOT_MODIFIED: S304_NotModified
		Nette\Http\IResponse::S305_USE_PROXY: S305_UseProxy
		Nette\Http\IResponse::S307_TEMPORARY_REDIRECT: S307_TemporaryRedirect
		Nette\Http\IResponse::S308_PERMANENT_REDIRECT: S308_PermanentRedirect
		Nette\Http\IResponse::S400_BAD_REQUEST: S400_BadRequest
		Nette\Http\IResponse::S401_UNAUTHORIZED: S401_Unauthorized
		Nette\Http\IResponse::S402_PAYMENT_REQUIRED: S402_PaymentRequired
		Nette\Http\IResponse::S403_FORBIDDEN: S403_Forbidden
		Nette\Http\IResponse::S404_NOT_FOUND: S404_NotFound
		Nette\Http\IResponse::S405_METHOD_NOT_ALLOWED: S405_MethodNotAllowed
		Nette\Http\IResponse::S406_NOT_ACCEPTABLE: S406_NotAcceptable
		Nette\Http\IResponse::S407_PROXY_AUTHENTICATION_REQUIRED: S407_ProxyAuthenticationRequired
		Nette\Http\IResponse::S408_REQUEST_TIMEOUT: S408_RequestTimeout
		Nette\Http\IResponse::S409_CONFLICT: S409_Conflict
		Nette\Http\IResponse::S410_GONE: S410_Gone
		Nette\Http\IResponse::S411_LENGTH_REQUIRED: S411_LengthRequired
		Nette\Http\IResponse::S412_PRECONDITION_FAILED: S412_PreconditionFailed
		Nette\Http\IResponse::S413_REQUEST_ENTITY_TOO_LARGE: S413_RequestEntityTooLarge
		Nette\Http\IResponse::S414_REQUEST_URI_TOO_LONG: S414_RequestUriTooLong
		Nette\Http\IResponse::S415_UNSUPPORTED_MEDIA_TYPE: S415_UnsupportedMediaType
		Nette\Http\IResponse::S416_REQUESTED_RANGE_NOT_SATISFIABLE: S416_RequestedRangeNotSatisfiable
		Nette\Http\IResponse::S417_EXPECTATION_FAILED: S417_ExpectationFailed
		Nette\Http\IResponse::S421_MISDIRECTED_REQUEST: S421_MisdirectedRequest
		Nette\Http\IResponse::S422_UNPROCESSABLE_ENTITY: S422_UnprocessableEntity
		Nette\Http\IResponse::S423_LOCKED: S423_Locked
		Nette\Http\IResponse::S424_FAILED_DEPENDENCY: S424_FailedDependency
		Nette\Http\IResponse::S426_UPGRADE_REQUIRED: S426_UpgradeRequired
		Nette\Http\IResponse::S428_PRECONDITION_REQUIRED: S428_PreconditionRequired
		Nette\Http\IResponse::S429_TOO_MANY_REQUESTS: S429_TooManyRequests
		Nette\Http\IResponse::S431_REQUEST_HEADER_FIELDS_TOO_LARGE: S431_RequestHeaderFieldsTooLarge
		Nette\Http\IResponse::S451_UNAVAILABLE_FOR_LEGAL_REASONS: S451_UnavailableForLegalReasons
		Nette\Http\IResponse::S500_INTERNAL_SERVER_ERROR: S500_InternalServerError
		Nette\Http\IResponse::S501_NOT_IMPLEMENTED: S501_NotImplemented
		Nette\Http\IResponse::S502_BAD_GATEWAY: S502_BadGateway
		Nette\Http\IResponse::S503_SERVICE_UNAVAILABLE: S503_ServiceUnavailable
		Nette\Http\IResponse::S504_GATEWAY_TIMEOUT: S504_GatewayTimeout
		Nette\Http\IResponse::S505_HTTP_VERSION_NOT_SUPPORTED: S505_HttpVersionNotSupported
		Nette\Http\IResponse::S506_VARIANT_ALSO_NEGOTIATES: S506_VariantAlsoNegotiates
		Nette\Http\IResponse::S507_INSUFFICIENT_STORAGE: S507_InsufficientStorage
		Nette\Http\IResponse::S508_LOOP_DETECTED: S508_LoopDetected
		Nette\Http\IResponse::S510_NOT_EXTENDED: S510_NotExtended
		Nette\Http\IResponse::S511_NETWORK_AUTHENTICATION_REQUIRED: S511_NetworkAuthenticationRequired
		Nette\Http\IResponse::SAME_SITE_LAX: SameSiteLax
		Nette\Http\IResponse::SAME_SITE_NONE: SameSiteNone
		Nette\Http\IResponse::SAME_SITE_STRICT: SameSiteStrict
	replaced-calls:
		'Nette\Http\Response::setCookie(time: $t, ...)': 'setCookie(expire: $t, ...)'
		'Nette\Http\Response::setExpiration(time: $t)': 'setExpiration(expire: $t)'
		'Nette\Http\Session::setExpiration(time: $t)': 'setExpiration(expire: $t)'
		'Nette\Http\SessionSection::setExpiration(time: $t, ...)': 'setExpiration(expire: $t, ...)'
		'Nette\Http\SessionSection::set(expiration: $e, ...)': 'set(expire: $e, ...)'
		'Nette\Http\SessionSection::__get($name)': 'get($name)'
		'Nette\Http\SessionSection::__set($name, $value)': 'set($name, $value)'
		'Nette\Http\SessionSection::__isset($name)': 'get($name) !== null'
		'Nette\Http\SessionSection::__unset($name)': 'remove($name)'
		'Nette\Http\SessionSection::offsetGet($name)': 'get($name)'
		'Nette\Http\SessionSection::offsetSet($name, $value)': 'set($name, $value)'
		'Nette\Http\SessionSection::offsetExists($name)': 'get($name) !== null'
		'Nette\Http\SessionSection::offsetUnset($name)': 'remove($name)'

since 3.1.7:
	forbidden-members:
		Nette\Http\Request::getReferer: 'use getOrigin(), which reads the Origin header and gives only the scheme, the host and the port instead of the whole URL of the referring page'

since 3.1:
	forbidden-classes:
		Nette\Http\UserStorage: 'use Nette\Bridges\SecurityHttp\SessionStorage from nette/security, which stores the identity differently'
	forbidden-members:
		Nette\Http\Response::$cookieHttpOnly: 'pass httpOnly: true or false to setCookie(), which sends HttpOnly by default'
		Nette\Http\Url::getBasePath: 'call getBasePath() on a Nette\Http\UrlScript, such as the one Nette\Http\Request::getUrl() returns'
		Nette\Http\Url::getBaseUrl: 'call getBaseUrl() on a Nette\Http\UrlScript, such as the one Nette\Http\Request::getUrl() returns'
		Nette\Http\Url::getRelativeUrl: 'call getRelativeUrl() on a Nette\Http\UrlScript, such as the one Nette\Http\Request::getUrl() returns'

since 3.0.6:
	replaced-calls:
		'Nette\Http\Session::setCookieParameters(samesite: $s, ...)': 'setCookieParameters(sameSite: $s, ...)'

since 3.0.5:
	replaced-members:
		Nette\Http\FileUpload::getName: getUntrustedName

since 3.0.3:
	replaced-members:
		Nette\Http\RequestFactory::createHttpRequest: fromGlobals
	forbidden-members:
		Nette\Http\IResponse::BROWSER: 'pass null as the expiration to setCookie()'
		Nette\Http\IResponse::PERMANENT: 'there is no replacement, the constant stood for a time far ahead; pass one to setCookie(), such as ''+10 years'''

since 3.0:
	replaced-members:
		Nette\Http\Session::setStorage: setHandler
		Nette\Http\Session::getCookieParameters: '\session_get_cookie_params'
	replaced-calls:
		'Nette\Http\Response::date()': '\Nette\Http\Helpers::formatDate(''now'')'
		'Nette\Http\Response::date($time)': '\Nette\Http\Helpers::formatDate($time)'
		'Nette\Http\Request::isPost()': 'isMethod(''POST'')'
		'Nette\Http\IRequest::getQuery($key, $default)': 'getQuery($key) ?? $default'
		'Nette\Http\IRequest::getPost($key, $default)': 'getPost($key) ?? $default'
		'Nette\Http\IRequest::getCookie($key, $default)': 'getCookie($key) ?? $default'
		'Nette\Http\IRequest::getHeader($header, $default)': 'getHeader($header) ?? $default'
		'Nette\Http\IResponse::getHeader($header, $default)': 'getHeader($header) ?? $default'
		'Nette\Http\Url::getQueryParameter($name, $default)': 'getQueryParameter($name) ?? $default'
		'Nette\Http\Url::setScheme(value: $v)': 'setScheme(scheme: $v)'
		'Nette\Http\Url::setUser(value: $v)': 'setUser(user: $v)'
		'Nette\Http\Url::setPassword(value: $v)': 'setPassword(password: $v)'
		'Nette\Http\Url::setHost(value: $v)': 'setHost(host: $v)'
		'Nette\Http\Url::setPort(value: $v)': 'setPort(port: $v)'
		'Nette\Http\Url::setPath(value: $v)': 'setPath(path: $v)'
		'Nette\Http\Url::setQuery(value: $v)': 'setQuery(query: $v)'
		'Nette\Http\Url::appendQuery(value: $v)': 'appendQuery(query: $v)'
		'Nette\Http\Url::setFragment(value: $v)': 'setFragment(fragment: $v)'
	forbidden-classes:
		Nette\Http\ISessionStorage: 'the interface is gone; implement \SessionHandlerInterface, whose destroy() and gc() take the place of remove() and clean()'
	forbidden-members:
		Nette\Http\Session::DEFAULT_FILE_LIFETIME: 'there is no replacement; write the lifetime as a value or set it with setExpiration()'
		Nette\Http\UrlScript::setScriptPath: 'the class is immutable; pass the script path as the second argument of its constructor'
		Nette\Http\UrlScript::setScheme: 'the class is immutable; take a changed copy with withScheme()'
		Nette\Http\UrlScript::setHost: 'the class is immutable; take a changed copy with withHost()'
		Nette\Http\UrlScript::setPort: 'the class is immutable; take a changed copy with withPort()'
		Nette\Http\UrlScript::setPath: 'the class is immutable; take a changed copy with withPath()'
		Nette\Http\UrlScript::setQuery: 'the class is immutable; take a changed copy with withQuery()'
		Nette\Http\UrlScript::setQueryParameter: 'the class is immutable; take a changed copy with withQueryParameter()'
		Nette\Http\UrlScript::setFragment: 'the class is immutable; take a changed copy with withFragment()'
		Nette\Http\UrlScript::appendQuery: 'the class is immutable and has no appendQuery(); build the whole query and pass it to withQuery()'
		Nette\Http\UrlScript::setUser: 'there is no replacement, the class is immutable and carries no credentials; send them apart from the URL'
		Nette\Http\UrlScript::setPassword: 'there is no replacement, the class is immutable and carries no credentials; send them apart from the URL'
